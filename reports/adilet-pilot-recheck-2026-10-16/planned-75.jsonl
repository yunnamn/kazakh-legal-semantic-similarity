{"source_document_id": "V990000741_", "url": "https://adilet.zan.kz/kaz/docs/V990000741_", "catalog_title": "Әскери қызметшілерге, Ішкі істер органдары, Қазақстан Республикасының Әдiлет министрлiгi Қылмыстық-атқару жүйесi комитетiнiң, қаржы полициясы және мемлекеттiк өртке қарсы қызмет органдарының қызметкерлеріне Зейнетақы төлеу жөніндегі мемлекеттік орталықтан еңбек сіңірген жылдары үшін зейнетақы, мемлекеттік базалық зейнетақы және мемлекеттік әлеуметтік жәрдемақы төлеуді жүзеге асыру жөніндегі Нұсқаулықты бекіту туралы", "catalog_date_adopted": "1999-03-19", "catalog_date_modified": "2007-04-19", "catalog_is_repealed": "t", "catalog_ekb_url": "http://law.gov.kz/client/#!/doc/2888/rus", "catalog_revision": "588f13ed7af351c485955698de72de18fe9acce8", "catalog_receipt_id": "c4690bf95858442187331638e02661f2f014add34a1a979ab622ce1d203383a5", "official_text_verified": false}
