{"source_document_id": "V23SA759715", "url": "https://adilet.zan.kz/kaz/docs/V23SA759715", "catalog_title": "\"Петропавл қаласына бірыңғай сәулеттік келбет беруге бағытталған, көппәтерлі тұрғын үйлердің қасбеттерін, шатырларын ағымдағы немесе күрделі жөндеу жөніндегі іс-шараларды ұйымдастыру және жүргізу қағидаларын бекіту туралы\" Петропавл қаласы әкімдігінің 2023 жылғы 10 қаңтардағы № 1546 қаулысына өзгерістер енгізу туралы", "catalog_date_adopted": "2023-10-16", "catalog_date_modified": null, "catalog_is_repealed": "f", "catalog_ekb_url": "http://law.gov.kz/client/#!/doc/187298/rus", "catalog_revision": "588f13ed7af351c485955698de72de18fe9acce8", "catalog_receipt_id": "c4690bf95858442187331638e02661f2f014add34a1a979ab622ce1d203383a5", "official_text_verified": false}
